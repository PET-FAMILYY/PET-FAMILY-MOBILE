{
  "expo": {
    "name": "Pet Family",
    "slug": "pet-family",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6F3CC3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petfamily.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6F3CC3"
      },
      "package": "com.petfamily.app",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6F3CC3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "scheme": "petfamily",
    "extra": {
      "eas": {
        "projectId": "96ca6563-1c66-4d99-b2d5-6117571e8bb4"
      }
    },
    "owner": "pedrovaz100"
  }
}
