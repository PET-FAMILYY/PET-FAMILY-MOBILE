# Copie este arquivo para .env (cp .env.example .env) e reinicie o Metro com: npx expo start -c

# API Java (backend principal) - publicada no Render (plano gratuito: a 1a chamada pode levar ~40s).
# Para rodar a API localmente, troque por:
#   Emulador Android:  http://10.0.2.2:9090
#   Simulador iOS:     http://localhost:9090
#   Celular fisico:    http://<IP-da-sua-maquina>:9090  (mesma rede Wi-Fi)
EXPO_PUBLIC_API_URL=https://petfamily-api.onrender.com

# API de IA (assistente PetDoc / Gemini) - publicada no Render.
# Repositorio: https://github.com/PET-FAMILYY/PET-FAMILY-IA
# Se omitida, o app usa https://pet-family-ia.onrender.com
EXPO_PUBLIC_IA_API_URL=https://pet-family-ia.onrender.com
